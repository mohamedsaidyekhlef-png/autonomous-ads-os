APP_ENV=development
DRY_RUN=true
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/ads_os
REDIS_URL=redis://HOST:6379/0
APP_SECRET_KEY=replace-with-a-long-random-secret
TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key
CORS_ORIGINS=http://localhost:3000,https://your-dashboard.vercel.app
DASHBOARD_URL=http://localhost:3000
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
# For hosted OpenAI-compatible APIs: LLM_PROVIDER=openai_compatible, LLM_BASE_URL=https://..., LLM_API_KEY=..., LLM_MODEL=...
WHOP_WEBHOOK_SECRET=replace-with-whop-webhook-secret
WHOP_REQUIRED_PRODUCT_ID=your_whop_product_id
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth/google/callback
META_REDIRECT_URI=http://localhost:8080/oauth/meta/callback
TIKTOK_REDIRECT_URI=http://localhost:8080/oauth/tiktok/callback
